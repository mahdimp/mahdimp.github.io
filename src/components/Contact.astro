<style>
  .contact {
    padding-block: var(--space-2xl) var(--space-3xl);
    border-top: 1px solid var(--color-border);
  }

  h2 {
    font-size: 1.5rem;
    font-weight: 600;
    margin: 0 0 var(--space-md);
  }

  .contact-list {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    padding: 0;
    margin: 0;
    font-weight: 600;
  }

  .contact-list a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
    padding: 0.5rem 0.75rem;
    border-radius: 8px;
    transition: background 150ms ease;
  }

  .contact-list a:hover {
    background: var(--color-muted);
  }

  .contact-list svg {
    flex-shrink: 0;
  }
</style>
