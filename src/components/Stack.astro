---
const stack = [
  'Angular',
  'TypeScript',
  'RxJS / Signals',
  'Nx',
  'Python / FastAPI',
  'AWS',
  'Datadog RUM',
];
---

<section id="stack" class="stack container">
  <h2>Stack</h2>
  <ul class="stack-list">
    {stack.map((item) => <li class="mono">{item}</li>)}
  </ul>
</section>

<style>
  .stack {
    padding-block: var(--space-2xl);
    border-top: 1px solid var(--color-border);
  }

  h2 {
    font-size: 1.5rem;
    font-weight: 600;
    margin: 0 0 var(--space-md);
  }

  .stack-list {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    padding: 0;
    margin: 0;
  }

  .stack-list li {
    font-size: 0.875rem;
    border: 1px solid var(--color-border);
    padding: 0.375rem 0.75rem;
    border-radius: 6px;
  }
</style>
