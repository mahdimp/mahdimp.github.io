---
import { caseStudies } from '../data/work';

const publishedWork = caseStudies.filter((project) => !project.draft);
---

<section id="work" class="work container">
  <span class="kicker">02 / SELECTED WORK</span>
  <h2>Selected work</h2>
  <div class="grid">
    {
      publishedWork.map((project) => (
        <article class="card">
          <h3>{project.title}</h3>
          <p>{project.summary}</p>
          <ul class="stack-tags">
            {project.stack.map((item) => (
              <li class="mono">{item}</li>
            ))}
          </ul>
          {project.link && (
            <a href={project.link.href} target="_blank" rel="noopener noreferrer" class="card-link">
              {project.link.label}
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M7 17L17 7" />
                <path d="M7 7h10v10" />
              </svg>
            </a>
          )}
        </article>
      ))
    }
  </div>
</section>

<style>
  .work {
    padding-block: var(--space-2xl);
    border-top: 1px solid var(--color-border);
  }

  h2 {
    font-size: 1.5rem;
    font-weight: 600;
    margin: 0 0 var(--space-lg);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--space-lg);
  }

  .card {
    background: var(--color-muted);
    border: 1px solid var(--color-border);
    border-top: 3px solid var(--color-primary);
    border-radius: 12px;
    padding: var(--space-md);
    transition: transform 200ms ease, box-shadow 200ms ease, border-color 200ms ease;
  }

  .card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-lg);
    border-color: var(--color-primary);
  }

  .card h3 {
    font-size: 1.125rem;
    font-weight: 600;
    margin: 0 0 var(--space-sm);
  }

  .card p {
    color: var(--color-muted-foreground);
    margin: 0 0 var(--space-md);
  }

  .stack-tags {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    padding: 0;
    margin: 0 0 var(--space-md);
  }

  .stack-tags li {
    font-size: 0.75rem;
    background: var(--color-background);
    color: var(--color-muted-foreground);
    border: 1px solid var(--color-border);
    padding: 0.25rem 0.5rem;
    border-radius: 4px;
    transition: border-color 150ms ease, color 150ms ease;
  }

  .card:hover .stack-tags li {
    border-color: var(--color-primary);
    color: var(--color-foreground);
  }

  .card-link {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    font-size: 0.875rem;
    font-weight: 600;
  }

  @media (prefers-reduced-motion: reduce) {
    .card:hover {
      transform: none;
    }
  }
</style>
